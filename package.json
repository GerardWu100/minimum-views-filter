{
  "name": "minimum-views-filter",
  "version": "1.0.3",
  "private": true,
  "description": "Filter low-view X Home posts and YouTube Home/watch recommendations locally.",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build": "node scripts/build.cjs",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --warnings-as-errors",
    "check": "npm test && npm run build && npm run lint:firefox",
    "benchmark": "node scripts/benchmark.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "web-ext": "^10.7.0"
  }
}
